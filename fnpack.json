    "logmanager": {
      "display_name": "飞牛日志管理",
      "desc": "飞牛日志管理工具，集中管理飞牛三方应用散落在各个文件夹的日志文件。支持统一网关接入免密登录、多标签页日志查看、实时追踪、22种通知渠道推送、自动清理策略、日志备份与归档、Docker容器日志、内核版本管理、MCP服务器等。",
      "platform": [
        "all"
      ],
      "categories": [
        "系统工具"
      ],
      "icon_url": "./logmanager/ICON.PNG",
      "readme_url": "./logmanager/README.md",
